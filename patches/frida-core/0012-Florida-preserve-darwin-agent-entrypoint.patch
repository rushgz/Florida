From 94b60c6cee43dbe2f04577f5b97b75d6f8cb5dc3 Mon Sep 17 00:00:00 2001
From: Florida <ci@florida.invalid>
Date: Wed, 26 Aug 2026 15:09:41 +0800
Subject: [PATCH] Florida: use Darwin-only agent entrypoint

---
 lib/agent/agent.vala                | 3 +++
 src/agent-container.vala            | 4 ++++
 src/darwin/darwin-host-session.vala | 2 +-
 tests/test-agent.vala               | 4 ++++
 tests/test-injector.vala            | 4 ++++
 5 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/lib/agent/agent.vala b/lib/agent/agent.vala
index f99f31f5..cc161892 100644
--- a/lib/agent/agent.vala
+++ b/lib/agent/agent.vala
@@ -1,4 +1,7 @@
 namespace Frida.Agent {
+#if DARWIN
+	[CCode (cname = "florida_agent_main")]
+#endif
 	public void main (string agent_parameters, ref Frida.UnloadPolicy unload_policy, void * injector_state) {
 		if (Runner.shared_instance == null)
 			Runner.create_and_run (agent_parameters, ref unload_policy, injector_state);
diff --git a/src/agent-container.vala b/src/agent-container.vala
index 86eb9f4a..3e54d857 100644
--- a/src/agent-container.vala
+++ b/src/agent-container.vala
@@ -28,7 +28,11 @@ namespace Frida {
 			}
 
 			void * main_func_symbol;
+#if DARWIN
+			var main_func_found = container.module.symbol ("florida_agent_main", out main_func_symbol);
+#else
 			var main_func_found = container.module.symbol ("main", out main_func_symbol);
+#endif
 			assert (main_func_found);
 			container.main_impl = (AgentMainFunc) main_func_symbol;
 
diff --git a/src/darwin/darwin-host-session.vala b/src/darwin/darwin-host-session.vala
index d712a56e..dc99480a 100644
--- a/src/darwin/darwin-host-session.vala
+++ b/src/darwin/darwin-host-session.vala
@@ -320,7 +320,7 @@ namespace Frida {
 		private async uint inject_agent (uint pid, string agent_parameters, Cancellable? cancellable) throws Error, IOError {
 			uint id;
 
-			unowned string entrypoint = "main";
+			unowned string entrypoint = "florida_agent_main";
 #if HAVE_EMBEDDED_ASSETS
 			id = yield fruitjector.inject_library_resource (pid, agent, entrypoint, agent_parameters, cancellable);
 #else
diff --git a/tests/test-agent.vala b/tests/test-agent.vala
index a1747efd..ea0795bd 100644
--- a/tests/test-agent.vala
+++ b/tests/test-agent.vala
@@ -452,7 +452,11 @@ Interceptor.attach(Process.getModuleByName('libsystem_kernel.dylib').getExportBy
 			}
 
 			void * main_func_symbol;
+#if DARWIN
+			var main_func_found = module.symbol ("florida_agent_main", out main_func_symbol);
+#else
 			var main_func_found = module.symbol ("main", out main_func_symbol);
+#endif
 			assert_true (main_func_found);
 			main_impl = (AgentMainFunc) main_func_symbol;
 
diff --git a/tests/test-injector.vala b/tests/test-injector.vala
index 4dc7b264..cb607a8c 100644
--- a/tests/test-injector.vala
+++ b/tests/test-injector.vala
@@ -258,7 +258,11 @@ namespace Frida.InjectorTest {
 				var path = Frida.Test.Labrats.path_to_library (name, arch);
 				assert_true (FileUtils.test (path, FileTest.EXISTS));
 
+#if DARWIN
+				yield injector.inject_library_file (process.id, path, "frida_agent_main", data);
+#else
 				yield injector.inject_library_file (process.id, path, "main", data);
+#endif
 			} catch (GLib.Error e) {
 				printerr ("\nFAIL: %s\n\n", e.message);
 				assert_not_reached ();
-- 
2.50.1 (Apple Git-155)

