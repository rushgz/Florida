+import sys
+
+import lief
+
+
+RANDOM_CHARSET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+
+
+def log_color(message):
+    print(f"\033[1;31;40m{message}\033[0m")
+
+
+def random_name(length):
+    return "".join(random.sample(RANDOM_CHARSET, length))
+
+
+def replace_bytes(path, old, new):
+    if len(old) != len(new):
+        raise ValueError(f"replacement length mismatch: {old!r} -> {new!r}")
+
+    data = path.read_bytes()
+    count = data.count(old)
+    if count == 0:
+        return 0
+
+    path.write_bytes(data.replace(old, new))
+    return count
+
+
